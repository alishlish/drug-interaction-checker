# Copy to .env and fill in. Only OPENAI_* / PINECONE_* are needed for /analyze
# and /check/explain — /check works with none of these set.

# --- Required for the LLM + RAG agent (/analyze, /check/explain) ---
OPENAI_API_KEY=
PINECONE_API_KEY=
# Pinecone index must be created by hand (dimension 1536, metric cosine) and
# populated via `python scripts/ingest.py`.
PINECONE_INDEX_NAME=drug-interactions

# --- Optional ---
# LLM_MODEL=gpt-4.1-mini
# CORS_ORIGINS=*
# DRUG_DATA_PATH=data/processed/drug_interactions_clean.csv
